# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจาก Supabase → Project Settings → API Keys
# สองค่านี้เปิดเผยได้ (ฝั่งเบราว์เซอร์ใช้) ข้อมูลถูกป้องกันด้วย RLS
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# ── AI (Claude) — ฝั่งเซิร์ฟเวอร์เท่านั้น ห้ามใส่ prefix NEXT_PUBLIC_ ──
# ไม่ใส่ key = โหมดจำลอง (ได้ผลลัพธ์ตัวอย่าง ไม่เสียเงิน)
# สร้าง key ที่ console.anthropic.com → API Keys (ต้องเติมเงินก่อน)
ANTHROPIC_API_KEY=
# รุ่นที่ใช้ (ค่าเริ่มต้น claude-sonnet-5-5) เปลี่ยนเป็น claude-haiku-5-5 ถ้าอยากประหยัด
# ANTHROPIC_MODEL=claude-sonnet-5-5
# บังคับโหมดจำลองแม้มี key: AI_MODE=mock
# AI_MODE=mock

# ── เลือกผู้ให้บริการ AI ── claude (ค่าเริ่มต้น) หรือ gemini (โควตาฟรี)
# เปลี่ยนกลับเมื่อไหร่ก็ได้: แก้ค่านี้ใน Vercel → Settings → Environment Variables แล้ว Redeploy
# AI_PROVIDER=gemini
# key ฟรีจาก aistudio.google.com/apikey (⚠ โควตาฟรี Google อาจนำข้อมูลที่ส่งไปใช้พัฒนาโมเดล)
GEMINI_API_KEY=
# รุ่นที่ใช้ (ค่าเริ่มต้น gemini-flash-latest)
# GEMINI_MODEL=gemini-flash-latest
